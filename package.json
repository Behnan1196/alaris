{
  "name": "alaris",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "env:sync": "node scripts/sync-env.mjs",
    "dev:web": "npm run env:sync && npm run dev -w @alaris/web",
    "dev:mobile": "npm run env:sync && npm run start -w @alaris/mobile",
    "build:web": "npm run env:sync && npm run build -w @alaris/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:db": "node --test supabase/tests/rls.test.mjs",
    "db:types": "supabase gen types --remote --lang typescript > packages/shared/src/database.types.ts",
    "db:push": "supabase db push --remote",
    "dev:mobile:tunnel": "npm run env:sync && npm run start -w @alaris/mobile -- --tunnel",
    "functions:deploy": "supabase functions deploy notify --no-verify-jwt --use-api",
    "db:exercises": "node scripts/gen-exercises.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "supabase": "^3.4.0"
  }
}
